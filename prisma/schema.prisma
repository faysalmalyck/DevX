// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  HIDDEN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  INVITED
  LOCKED
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  PUBLISH
  APPROVE
  EXPORT
  IMPORT
  MANAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  DUPLICATE
}

enum LeadSource {
  AGENT_REFERRAL
  AGENT_MANUAL
  WEBSITE_CONTACT
  WEBSITE_CONSULTATION
  WEBSITE_PRICING
  WHATSAPP
  IMPORTED
  OTHER
}

enum LeadContactType {
  PROSPECT
  VENDOR
  PARTNER
  OTHER
}

enum LeadCaptureSurface {
  CONTACT
  CONSULTATION
  PRICING
  MANUAL
  IMPORT
  OTHER
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGE
  NOTE
  ASSIGNMENT
  CONTACT_ATTEMPT
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  MARKED_DUPLICATE
  EMAIL_DRAFTED
  EMAIL_QUEUED
  EMAIL_SENT
  EMAIL_FAILED
  EMAIL_DELIVERED
  EMAIL_BOUNCED
  EMAIL_CANCELLED
  VENDOR_OUTREACH_BATCH_CREATED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SalesTeamRole {
  SALES_MANAGER
  SALES_AGENT
}

enum TeamMemberAccessRole {
  ADMINISTRATOR
  SALES_MANAGER
  SALES_AGENT
}

enum LeadEmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

enum VendorOutreachBatchStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  CANCELLED
}

model Client {
  id             String       @id @default(cuid())
  companyName    String       @unique
  slug           String       @unique
  logo           String
  website        String
  description    String?
  industry       String?
  country        String?
  displayOrder   Int          @default(0)
  featured       Boolean      @default(false)
  status         ClientStatus @default(ACTIVE)
  openInNewTab   Boolean      @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([status, featured, displayOrder])
  @@index([deletedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Admin {
  id                     String                @id @default(cuid())
  firstName              String
  lastName               String
  email                  String                @unique
  phone                  String?
  username               String                @unique
  password               String
  avatar                 String?
  designation            String?
  department             String?
  bio                    String?
  timezone               String                @default("UTC")
  language               String                @default("en")
  roleId                 String
  role                   Role                  @relation(fields: [roleId], references: [id])
  status                 AdminStatus           @default(ACTIVE)
  twoFactorEnabled       Boolean               @default(false)
  requirePasswordChange  Boolean               @default(true)
  passwordExpiresAt      DateTime?
  failedLoginAttempts    Int                   @default(0)
  lockedUntil            DateTime?
  lastLogin              DateTime?
  sessions               AdminSession[]
  activities             AdminActivity[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  agentCode              String?               @unique
  assignedLeads          Lead[]                @relation("AgentAssignedLeads")
  createdLeads           Lead[]                @relation("AgentCreatedLeads")
  referredLeads          Lead[]                @relation("AgentReferredLeads")
  leadActivities         LeadActivity[]        @relation("LeadActivityActor")
  assignedFollowUps      LeadFollowUp[]        @relation("AgentAssignedFollowUps")
  createdFollowUps       LeadFollowUp[]        @relation("AgentCreatedFollowUps")
  sentLeadEmails         LeadEmail[]           @relation("LeadEmailSender")
  createdOutreachBatches VendorOutreachBatch[] @relation("VendorOutreachBatchCreator")
  teamMember             TeamMember?           @relation("TeamMemberAdmin")

  @@index([roleId, status])
  @@index([deletedAt])
}

model Role {
  id           String           @id @default(cuid())
  name         String           @unique
  slug         String           @unique
  description  String?
  isSystem     Boolean          @default(false)
  isSuperAdmin Boolean          @default(false)
  admins       Admin[]
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Permission {
  id     String           @id @default(cuid())
  module String
  action PermissionAction
  roles  RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  device    String?
  browser   String?
  ipAddress String?
  location  String?
  loginAt   DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId, expiresAt])
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String
  module      String
  description String
  ipAddress   String?
  browser     String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([module, createdAt])
}

model User {
  id                    String            @id @default(cuid())
  firstName             String
  lastName              String
  email                 String            @unique
  username              String            @unique
  password              String
  avatar                String?
  phone                 String?
  status                AdminStatus       @default(ACTIVE)
  role                  String            @default("Client")
  requirePasswordChange Boolean           @default(false)
  passwordChangedAt     DateTime?
  lastLogin             DateTime?
  sessions              UserSession[]
  activities            UserActivity[]
  supportTickets        SupportTicket[]
  serviceRequests       ServiceRequest[]
  plannedActivities     PlannedActivity[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  emailVerified         Boolean           @default(false)
  emailVerifiedAt       DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?

  @@index([status, role])
  @@index([deletedAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String?
  browser   String?
  ipAddress String?
  location  String?
  loginAt   DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  module    String
  browser   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  priority  TicketPriority  @default(MEDIUM)
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, status])
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String // User ID or Admin ID
  senderType  String // "user" or "admin"
  senderName  String
  content     String
  attachments String[] // URL list of attachments
  createdAt   DateTime      @default(now())

  @@index([ticketId])
}

model Notification {
  id            String   @id @default(cuid())
  recipientId   String // User ID or Admin ID
  recipientType String // "user" or "admin"
  type          String // "PROJECT_UPDATE", "MESSAGE", "INVOICE", "MEETING", "SECURITY", etc.
  title         String
  message       String
  read          Boolean  @default(false)
  link          String?
  createdAt     DateTime @default(now())

  @@index([recipientId, read])
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

model ServiceRequest {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceName  String // "Web Development", "Mobile App Development", etc.
  status       ServiceStatus @default(PENDING)
  assignedTeam String        @default("Unassigned")
  progress     Int           @default(0)
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, status])
}

enum ActivityStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model PlannedActivity {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // "meeting", "consultation", "milestone", "task", "event"
  title       String
  description String?
  scheduledAt DateTime
  status      ActivityStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, scheduledAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CareerStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

enum TeamMemberStatus {
  DRAFT
  PUBLISHED
}

enum TeamMemberDepartment {
  EXECUTIVE
  ENGINEERING
  MOBILE
  SALES
  MARKETING
}

enum TeamMemberProfileStatus {
  INCOMPLETE
  COMPLETE
}

model Career {
  id                          String        @id @default(cuid())
  title                       String
  slug                        String        @unique
  department                  String
  category                    String?
  location                    String
  employmentType              String
  workMode                    String
  experience                  String
  shortDescription            String
  overview                    String
  responsibilitiesDescription String        @default("")
  responsibilities            Json
  requirementsDescription     String        @default("")
  requirements                Json
  preferredQualifications     Json
  hiringProcess               Json
  featured                    Boolean       @default(false)
  displayOrder                Int           @default(0)
  status                      CareerStatus  @default(DRAFT)
  publishedAt                 DateTime?
  applications                Application[]
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  @@index([status, displayOrder])
  @@index([category, status, displayOrder])
}

model Application {
  id                     String            @id @default(cuid())
  careerId               String
  career                 Career            @relation(fields: [careerId], references: [id], onDelete: Restrict)
  fullName               String
  email                  String
  phone                  String
  currentLocation        String
  yearsOfExperience      Int
  linkedinUrl            String?
  portfolioUrl           String?
  coverLetter            String
  resumeStorageKey       String            @unique
  resumeOriginalFilename String
  resumeMimeType         String
  resumeSize             Int
  consentConfirmed       Boolean
  status                 ApplicationStatus @default(NEW)
  internalNotes          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([careerId, email])
  @@index([careerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ApplicationRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model Lead {
  id             String              @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  company        String?
  message        String?
  budgetRange    String?
  estimatedValue Decimal?            @db.Decimal(12, 2)
  status         LeadStatus          @default(NEW)
  contactType    LeadContactType     @default(PROSPECT)
  source         LeadSource          @default(WEBSITE_CONTACT)
  captureSurface LeadCaptureSurface?

  assignedAgentId   String?
  assignedAgent     Admin?  @relation("AgentAssignedLeads", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  createdByAgentId  String?
  createdByAgent    Admin?  @relation("AgentCreatedLeads", fields: [createdByAgentId], references: [id], onDelete: Restrict)
  referralAgentId   String?
  referralAgent     Admin?  @relation("AgentReferredLeads", fields: [referralAgentId], references: [id], onDelete: Restrict)
  referralAgentCode String?

  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates    Lead[]  @relation("LeadDuplicates")

  lostReason       String?
  statusChangedAt  DateTime  @default(now())
  lastContactedAt  DateTime?
  wonAt            DateTime?
  lostAt           DateTime?
  doNotEmail       Boolean   @default(false)
  doNotEmailReason String?
  emailBouncedAt   DateTime?

  activities LeadActivity[]
  followUps  LeadFollowUp[]
  emails     LeadEmail[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([assignedAgentId, status, deletedAt])
  @@index([contactType, assignedAgentId, deletedAt])
  @@index([referralAgentId, createdAt])
  @@index([referralAgentCode])
  @@index([email, deletedAt])
  @@index([source, createdAt])
  @@index([deletedAt])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actorId   String?
  actor     Admin?           @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  type      LeadActivityType
  note      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
}

model LeadFollowUp {
  id              String         @id @default(cuid())
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  assignedAgentId String
  assignedAgent   Admin          @relation("AgentAssignedFollowUps", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       Admin          @relation("AgentCreatedFollowUps", fields: [createdById], references: [id], onDelete: Restrict)
  dueAt           DateTime
  status          FollowUpStatus @default(PENDING)
  note            String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([assignedAgentId, status, dueAt])
  @@index([leadId, dueAt])
  @@index([deletedAt])
}

model LeadEmail {
  id                String               @id @default(cuid())
  leadId            String
  lead              Lead                 @relation(fields: [leadId], references: [id], onDelete: Restrict)
  senderAdminId     String
  senderAdmin       Admin                @relation("LeadEmailSender", fields: [senderAdminId], references: [id], onDelete: Restrict)
  toEmail           String
  fromEmail         String
  replyToEmail      String?
  subject           String
  bodyText          String
  bodyHtml          String?
  status            LeadEmailStatus      @default(DRAFT)
  providerName      String?
  providerMessageId String?
  idempotencyKey    String               @unique
  retryOfId         String?
  retryOf           LeadEmail?           @relation("LeadEmailRetries", fields: [retryOfId], references: [id], onDelete: Restrict)
  retryAttempts     LeadEmail[]          @relation("LeadEmailRetries")
  outreachBatchId   String?
  outreachBatch     VendorOutreachBatch? @relation(fields: [outreachBatchId], references: [id], onDelete: Restrict)
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  bouncedAt         DateTime?
  cancelledAt       DateTime?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  @@unique([providerName, providerMessageId])
  @@index([leadId, createdAt])
  @@index([senderAdminId, createdAt])
  @@index([status, createdAt])
  @@index([retryOfId])
  @@index([outreachBatchId, createdAt])
  @@index([deletedAt])
}

model VendorOutreachBatch {
  id               String                    @id @default(cuid())
  name             String
  status           VendorOutreachBatchStatus @default(DRAFT)
  createdByAdminId String
  createdByAdmin   Admin                     @relation("VendorOutreachBatchCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  queuedAt         DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  emails           LeadEmail[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?

  @@index([createdByAdminId, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model LeadCaptureRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

// Durable cleanup queue for private resume objects when storage and Postgres
// cannot be changed in one transaction.
model ResumeCleanup {
  storageKey    String   @id
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt])
}

model TeamMember {
  id               String                  @id @default(cuid())
  name             String?
  slug             String?                 @unique
  role             String?
  department       TeamMemberDepartment?
  legacyDepartment String?
  bio              String?
  about            String?
  aboutParagraph2   String?
  highlights       String[]                @default([])
  experience       String?
  image            String?
  email            String?                 @unique
  accessRole       TeamMemberAccessRole?
  salesRole        SalesTeamRole?
  adminId          String?                 @unique
  admin            Admin?                  @relation("TeamMemberAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  phone            String?
  linkedinUrl      String?
  facebookUrl      String?
  twitterUrl       String?
  githubUrl        String?
  displayOrder     Int                     @default(0)
  featured         Boolean                 @default(false)
  status           TeamMemberStatus        @default(DRAFT)
  profileStatus    TeamMemberProfileStatus @default(INCOMPLETE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  @@index([status, deletedAt, displayOrder])
  @@index([deletedAt, displayOrder, createdAt])
}
